<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Unicorn izleme yapmaz, hiçbir kullanıcı verisi toplamaz/ağ üzerinden göndermez.
         Tüm oyun verisi yalnızca cihazda (Documents/save.json) tutulur. -->
    <key>NSPrivacyTracking</key>
    <false/>
    <key>NSPrivacyTrackingDomains</key>
    <array/>
    <key>NSPrivacyCollectedDataTypes</key>
    <array/>
    <!-- Required-reason API beyanı: AudioManager ses ayarını UserDefaults'ta saklar.
         CA92.1 = uygulamanın kendi ayarlarına erişim (cihaz dışına çıkmaz). -->
    <key>NSPrivacyAccessedAPITypes</key>
    <array>
        <dict>
            <key>NSPrivacyAccessedAPIType</key>
            <string>NSPrivacyAccessedAPICategoryUserDefaults</string>
            <key>NSPrivacyAccessedAPITypeReasons</key>
            <array>
                <string>CA92.1</string>
            </array>
        </dict>
    </array>
</dict>
</plist>
